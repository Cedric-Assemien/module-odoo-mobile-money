<odoo>
    <record id="mm_network_tree" model="ir.ui.view">
        <field name="name">mm.network.tree</field>
        <field name="model">mm.network</field>
        <field name="arch" type="xml">
            <list string="Réseaux">
                <field name="name"/>
                <field name="code"/>
                <field name="fee_percentage"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="mm_network_form" model="ir.ui.view">
        <field name="name">mm.network.form</field>
        <field name="model">mm.network</field>
        <field name="arch" type="xml">
            <form string="Réseau">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="fee_percentage"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mm_network_search" model="ir.ui.view">
        <field name="name">mm.network.search</field>
        <field name="model">mm.network</field>
        <field name="arch" type="xml">
            <search string="Réseaux">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <filter name="filter_active" string="Actif" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactif" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="mm_network_action" model="ir.actions.act_window">
        <field name="name">Réseaux</field>
        <field name="res_model">mm.network</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="mm_network_search"/>
    </record>
</odoo>