<odoo>
    <data noupdate="1">
        <record id="mm_group_user" model="res.groups">
            <field name="name">Agent Mobile Money</field>
            <field name="category_id" ref="base.module_category_accounting"/>
        </record>

        <record id="mm_group_manager" model="res.groups">
            <field name="name">Gestionnaire Mobile Money</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="implied_ids" eval="[(4, ref('mm_group_user'))]"/>
        </record>

        <record id="mm_group_settings" model="res.groups">
            <field name="name">Paramètres Mobile Money</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="implied_ids" eval="[(4, ref('mm_group_manager'))]"/>
        </record>
    </data>
</odoo>
