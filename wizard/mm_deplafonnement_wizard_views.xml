<odoo>
    <record id="mm_deplafonnement_wizard_view" model="ir.ui.view">
        <field name="name">mm.deplafonnement.wizard.form</field>
        <field name="model">mm.deplafonnement.wizard</field>
        <field name="arch" type="xml">
            <form string="Deplafonnement Request">
                <sheet>
                    <group>
                        <field name="customer_id" readonly="1"/>
                        <field name="identity_type"/>
                        <field name="identity_number"/>
                        <field name="attachment_datas" filename="attachment_filename"/>
                        <field name="attachment_filename" invisible="1"/>
                        <field name="notes" placeholder="Add a note for the reviewer"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>