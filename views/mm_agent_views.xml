<odoo>
    <record id="mm_agent_tree" model="ir.ui.view">
        <field name="name">mm.agent.tree</field>
        <field name="model">mm.agent</field>
        <field name="arch" type="xml">
            <list string="Agents">
                <field name="name"/>
                <field name="user_id"/>
                <field name="service_point_id"/>
                <field name="transaction_count"/>
                <field name="transaction_total_amount"/>
                <field name="last_transaction_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="mm_agent_form" model="ir.ui.view">
        <field name="name">mm.agent.form</field>
        <field name="model">mm.agent</field>
        <field name="arch" type="xml">
            <form string="Agent">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_transactions" class="oe_stat_button" icon="fa-exchange-alt">
                            <field name="transaction_count" widget="statinfo" string="Transactions"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="service_point_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="transaction_total_amount" readonly="1"/>
                            <field name="last_transaction_date" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mm_agent_search" model="ir.ui.view">
        <field name="name">mm.agent.search</field>
        <field name="model">mm.agent</field>
        <field name="arch" type="xml">
            <search string="Agents">
                <field name="user_id"/>
                <field name="service_point_id"/>
                <filter name="filter_active" string="Actifs" domain="[('active','=',True)]"/>
                <group expand="0" string="Grouper Par">
                    <filter name="group_service_point" string="Point de Service" context="{'group_by': 'service_point_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mm_agent_action" model="ir.actions.act_window">
        <field name="name">Agents</field>
        <field name="res_model">mm.agent</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="mm_agent_search"/>
    </record>

    <!-- Graph/Pivot basés sur mm.transaction pour performance par agent -->
    <record id="mm_agent_transaction_graph" model="ir.ui.view">
        <field name="name">mm.transaction.graph.by.agent</field>
        <field name="model">mm.transaction</field>
        <field name="arch" type="xml">
            <graph string="Performance Agents" type="bar">
                <field name="amount" type="measure"/>
                <field name="agent_id" type="row"/>
                <field name="transaction_date" interval="month" type="col"/>
            </graph>
        </field>
    </record>

    <record id="mm_agent_performance_action" model="ir.actions.act_window">
        <field name="name">Performance des Agents</field>
        <field name="res_model">mm.transaction</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="mm_agent_transaction_graph"/>
        <field name="context">{'search_default_group_agent': 1, 'search_default_filter_last_30_days': 1}</field>
    </record>
</odoo>