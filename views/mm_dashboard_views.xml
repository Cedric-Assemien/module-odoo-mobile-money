<odoo>
    <!-- Vue graph existante pour Transactions (déjà présente) -->
    <record id="mm_transaction_kanban" model="ir.ui.view">
        <field name="name">mm.transaction.kanban</field>
        <field name="model">mm.transaction</field>
        <field name="arch" type="xml">
            <kanban default_group_by="transaction_type" class="o_mm_transaction_kanban">
                <field name="amount"/>
                <field name="monthly_usage_percentage"/>
                <field name="state"/>
                <field name="transaction_date"/>
                <field name="customer_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_record">
                            <div class="o_kanban_primary_left">
                                <strong><field name="name"/></strong>
                                <div><field name="transaction_date"/></div>
                                <div><field name="customer_id"/></div>
                                <div><field name="network_id"/></div>
                            </div>
                            <div class="o_kanban_primary_right">
                                <span class="o_stat_value">
                                    <field name="amount" widget="monetary"/>
                                </span>
                                <div class="o_progress">
                                    <field name="monthly_usage_percentage" widget="progressbar" options="{'max': 100}"/>
                                </div>
                                <div class="o_badge">
                                    <field name="state" widget="badge"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Activité par Point de Service -->
    <record id="mm_service_point_transaction_graph" model="ir.ui.view">
        <field name="name">mm.transaction.graph.by.service.point</field>
        <field name="model">mm.transaction</field>
        <field name="arch" type="xml">
            <graph string="Activité Points de Service" type="bar">
                <field name="amount" type="measure"/>
                <field name="service_point_id" type="row"/>
                <field name="transaction_date" interval="month" type="col"/>
            </graph>
        </field>
    </record>

    <record id="mm_service_point_activity_action" model="ir.actions.act_window">
        <field name="name">Activité Points de Service</field>
        <field name="res_model">mm.transaction</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="mm_service_point_transaction_graph"/>
        <field name="search_view_id" ref="mm_transaction_search"/>
        <field name="context">{'search_default_group_service_point': 1, 'search_default_filter_last_30_days': 1}</field>
    </record>

    <!-- Inscription Clients par jour/heure -->
    <record id="mm_customer_signup_graph" model="ir.ui.view">
        <field name="name">mm.customer.graph.signup</field>
        <field name="model">mm.customer</field>
        <field name="arch" type="xml">
            <graph string="Inscriptions Clients" type="line">
                <field name="create_date" interval="day" type="row"/>
            </graph>
        </field>
    </record>
    <record id="mm_customer_signup_action" model="ir.actions.act_window">
        <field name="name">Inscriptions Clients</field>
        <field name="res_model">mm.customer</field>
        <field name="view_mode">graph,list</field>
        <field name="view_id" ref="mm_customer_signup_graph"/>
    </record>

    <!-- Total transactions par client -->
    <record id="mm_customer_tx_graph" model="ir.ui.view">
        <field name="name">mm.transaction.graph.by.customer</field>
        <field name="model">mm.transaction</field>
        <field name="arch" type="xml">
            <graph string="Transactions par Client" type="bar">
                <field name="amount" type="measure"/>
                <field name="customer_id" type="row"/>
            </graph>
        </field>
    </record>
    <record id="mm_customer_tx_action" model="ir.actions.act_window">
        <field name="name">Transactions par Client</field>
        <field name="res_model">mm.transaction</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="mm_customer_tx_graph"/>
        <field name="search_view_id" ref="mm_transaction_search"/>
    </record>
</odoo>